/* Firefox light — shared with the user's Obsidian workspace. */
QWidget { color: #392b43; font-family: "Segoe UI"; font-size: 16px; }
QMainWindow, QWidget#shell { background: #f3edf9; }
QWidget#shell { border: 1px solid #d5c5e1; }
QWidget#content { background: #fbf8ff; border-top-left-radius: 18px; }
QWidget#focusContent { background: #fbf8ff; }
QLabel#focusEmpty { color: #796183; font-size: 16px; }
QFrame#spectrum { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7b18f4, stop:0.48 #f527aa, stop:0.78 #ff6a00, stop:1 #ffba00); border: none; }
QWidget#titlebar { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ead7fb, stop:0.52 #ffe2f2, stop:1 #ffecd9); }
QFrame#sidebar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f8e5f4, stop:1 #f3edf9); border: none; }
QLabel#brand { color: #542471; font-size: 18px; font-weight: 600; }
QLabel#appmark { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8a3fd1, stop:0.6 #b82e70, stop:1 #e87500); border-radius: 9px; color: white; font-weight: 600; font-size: 14px; }
QLabel#heading { color: #542471; font-size: 30px; font-weight: 600; }
QLabel#subtitle, QLabel#muted { color: #6c5776; }
QLabel#eyebrow { color: #796183; font-size: 12px; font-weight: 600; letter-spacing: 1px; }
QLabel#tasktitle { color: #542471; font-size: 30px; font-weight: 600; }
QCheckBox#taskCheck { padding: 0; }
QFrame#taskLine { background: transparent; border: none; border-radius: 8px; }
QFrame#taskLine:hover { background: #f0e7f6; }
QPlainTextEdit#workText { font-size: 16px; background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 0; selection-background-color: #e9c9f0; }
QPlainTextEdit#workText[mode="work"] { font-size: 21px; }
QPlainTextEdit#workText[mode="work"][root="true"] { font-weight: 600; }
QPlainTextEdit#workText:focus { background: #fffcff; border-color: #8a3fd1; }
QPlainTextEdit#workText[error="true"] { background: #fff0f2; border-color: #b82e70; }
QFrame#workDraft { background: #f3edf9; border: 1px solid #b79dca; border-radius: 10px; }
QFrame#workDraft QPushButton#primary { padding: 0 10px; }
QLabel#timer { color: #542471; font-family: "Segoe UI"; font-size: 78px; font-weight: 400; }
QLabel#sessionTimer { color: #542471; font-family: "Segoe UI"; font-size: 36px; font-weight: 400; }
QTreeWidget#workspaceTasks { background: transparent; border: none; outline: none; }
QTreeWidget#workspaceTasks::item { background: transparent; border: none; }
QTreeWidget#workspaceTasks::item:selected, QTreeWidget#workspaceTasks::item:hover { background: transparent; }
QTreeWidget#workspaceTasks::branch { background: transparent; border: none; }
QListWidget { background: #fffcff; border: 1px solid #e0d3e9; border-radius: 12px; }
QLabel#focusTitle { color: #542471; font-size: 23px; font-weight: 600; }
QLabel#correctionPreview { background: #f0e3f8; border-radius: 12px; color: #542471; padding: 14px; }
QPushButton#segment { background: transparent; border-color: transparent; padding: 6px 12px; }
QPushButton#segment:checked { background: #dfc9ee; color: #542471; }
QLineEdit#durationNumber { font-size: 26px; color: #542471; padding: 9px 12px; border-radius: 10px; }
QPlainTextEdit { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 10px; padding: 10px; }
QSpinBox::up-button, QSpinBox::down-button, QDateTimeEdit::up-button, QDateTimeEdit::down-button, QDateEdit::up-button, QDateEdit::down-button { width: 0; height: 0; border: none; }
QTreeWidget#workspaceTasks::indicator { width: 19px; height: 19px; }
QHeaderView::section { background: #f3edf9; color: #796183; padding: 7px 5px; border: none; border-bottom: 1px solid #e0d3e9; }
QDialog { background: #fbf8ff; }
QTabWidget::pane { border: 1px solid #d5c5e1; border-radius: 8px; background: #fffcff; }
QTabBar::tab { padding: 9px 14px; background: #f3edf9; color: #604c6b; }
QTabBar::tab:selected { background: #dfc9ee; color: #542471; }
QLabel#chip { background: #f0e3f8; color: #70339b; border-radius: 10px; padding: 5px 12px; font-size: 14px; }
QFrame#queueCard { background: #f6f0fa; border: 1px solid #d5c5e1; border-radius: 16px; }
QFrame#queueCard[selected="true"] { border: 1px solid #8a3fd1; background: #f1e8f9; }
QFrame#taskGroup { background: #fffcff; border: 1px solid #e0d3e9; border-radius: 10px; }
QFrame#taskGroup[startSelected="true"] { background: #f0e1fa; border-color: #8a3fd1; }
QLabel#startTaskHint { color: #70339b; font-size: 13px; margin: 4px 10px 2px 10px; }
QFrame#taskRow { background: transparent; border: none; }
QFrame#workTask { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 18px; }
QFrame#creativeTasks { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 16px; }
QFrame#launchBar { background: #f3edf9; border: 1px solid #d5c5e1; border-radius: 14px; }
QFrame#statCard { background: #fff8f1; border: 1px solid #ead6c4; border-radius: 14px; }
QFrame#historyRow { background: #fffcff; border: 1px solid #e0d3e9; border-radius: 12px; }
QPushButton, QToolButton { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 9px; padding: 8px 12px; }
QPushButton:hover, QToolButton:hover { background: #eadef2; border-color: #b79dca; }
QPushButton:pressed, QToolButton:pressed { background: #dfcceb; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QSpinBox:focus { border: 1px solid #8a3fd1; }
QPushButton:disabled, QToolButton:disabled { color: #95879e; background: #eee8f2; border-color: #ded3e6; }
QPushButton#primary { background: #8a3fd1; border-color: #8a3fd1; color: white; padding: 11px 22px; font-weight: 600; }
QPushButton#primary:hover { background: #7130b3; border-color: #7130b3; }
QPushButton#primary:pressed { background: #59238e; }
QPushButton#primary:disabled { background: #e2d7eb; color: #86708f; border-color: #d5c5e1; }
QPushButton#primary:focus { border-color: #542471; }
QPushButton#queueTitle { color: #542471; font-weight: 600; text-align: left; background: transparent; border: 1px solid transparent; padding: 0; }
QPushButton#queueTitle:focus { color: #8a3fd1; border-color: #8a3fd1; }
QPushButton#queueTitle:hover { color: #8a3fd1; }
QPushButton#queueSelect { background: #8a3fd1; border-color: #8a3fd1; color: white; padding: 0; }
QPushButton#queueSelect:hover { background: #7130b3; }
QPushButton#queueSelect:pressed { background: #59238e; }
QPushButton#queueSelect:focus { border-color: #542471; }
QPushButton#queueSelect:disabled { background: #e2d7eb; border-color: #d5c5e1; color: #86708f; }
QLabel#launchQueue { color: #542471; font-weight: 600; }
QPushButton#timeButton { padding: 0 10px; }
QFrame#launchBar QPushButton#primary { padding: 0 16px; }
QFrame#launchBar[compact="true"] QPushButton#timeButton { padding: 0 6px; }
QFrame#launchBar[compact="true"] QPushButton#primary { padding: 0 8px; }
QSpinBox#duration { padding: 0 8px; }
QPushButton#nav { text-align: left; background: transparent; border: 1px solid transparent; padding: 12px 14px; color: #604c6b; border-radius: 10px; }
QPushButton#nav:hover { background: #eadef2; }
QPushButton#nav:checked { background: #dfc9ee; color: #542471; font-weight: 600; }
QPushButton#nav:focus { border-color: #8a3fd1; }
QPushButton#ghost, QToolButton#ghost { background: transparent; border: 1px solid transparent; }
QPushButton#ghost:hover, QToolButton#ghost:hover { background: #eadef2; }
QPushButton#ghost:focus { border-color: #8a3fd1; }
QPushButton#ghost:disabled { background: transparent; border-color: transparent; color: #a092a8; }
QPushButton#deleteSession { background: transparent; border-color: transparent; padding: 0 10px; }
QPushButton#deleteSession:hover { background: #fce2ed; color: #962253; }
QPushButton#deleteSession:pressed { background: #f4cddd; }
QPushButton#deleteSession:focus { border-color: #8a3fd1; }
QPushButton#taskMenu { padding: 0; background: transparent; border-color: transparent; }
QPushButton#taskMenu:hover { background: #eadef2; }
QPushButton#taskMenu:focus { border-color: #8a3fd1; }
QPushButton#taskMenu:disabled { background: transparent; border-color: transparent; }
QToolButton#dragHandle { padding: 0; background: transparent; border-color: transparent; }
QToolButton#dragHandle:hover { background: #eadef2; }
QPushButton#favorite { font-size: 26px; padding: 0; color: #9c88a8; }
QPushButton#favorite[selected="true"] { color: #ad3f09; background: #fff0d9; border-color: #e7b985; }
QPushButton#historyFilter:checked { background: #f0e1fa; border-color: #8a3fd1; color: #70339b; }
QPushButton#windowClose { background: transparent; border-color: transparent; padding: 0; }
QPushButton#windowClose:hover { background: #f4cddd; }
QPushButton#finishSession { background: #fbe5ef; border-color: #dcb4c9; color: #962253; }
QPushButton#finishSession:hover { background: #f4cddd; border-color: #b82e70; }
QLineEdit, QSpinBox, QComboBox { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 8px; padding: 8px 10px; selection-background-color: #e9c9f0; selection-color: #392b43; }
QSpinBox { padding-right: 16px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 20px; height: 20px; border: 1px solid #b79dca; border-radius: 6px; background: #fffcff; }
QCheckBox::indicator:checked { background: #ad5300; border-color: #ad5300; image: none; }
QCheckBox::indicator:hover { border-color: #8a3fd1; }
QScrollArea { border: none; background: transparent; }
QWidget#scrollBody { background: transparent; }
QScrollBar:vertical { background: transparent; width: 14px; margin: 2px 0; }
QScrollBar::handle:vertical { background: transparent; min-height: 40px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { border: none; border-radius: 2px; background: #e8dcec; max-height: 4px; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8a3fd1, stop:0.55 #d14286, stop:1 #e87500); border-radius: 2px; }
QMenu { background: #fffcff; border: 1px solid #d5c5e1; border-radius: 9px; padding: 5px; }
QMenu::item { padding: 8px 24px; border-radius: 5px; }
QMenu::item:selected { background: #eadef2; }
QMenu::item:disabled { color: #a092a8; }
QMenu::separator { height: 1px; background: #e0d3e9; margin: 4px 8px; }
QToolTip { background: #fffcff; color: #392b43; border: 1px solid #b79dca; padding: 7px; }
QLabel#toast { background: #f0e3f8; color: #542471; border: 1px solid #d5c5e1; border-radius: 10px; padding: 12px; }
QLabel#toast[error="true"] { background: #fff0f2; border-color: #d69cb7; color: #962253; }
